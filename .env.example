# 이 파일은 "양식"입니다. 실제 값은 넣지 마세요.
# 실제 값은 .env.local 파일에 넣습니다 (.env.local 은 GitHub에 올라가지 않습니다).

# Supabase > Connect 창 또는 Integrations > Data API 에 있는 주소
SUPABASE_URL=

# Supabase > Settings > API Keys > Publishable key  (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Settings > API Keys > Secret keys 의 default  (sb_secret_...)  ← 마스터키, 절대 공개 금지
SUPABASE_SECRET_KEY=
